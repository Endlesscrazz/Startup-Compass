# Copy this to .env and fill in your keys
# NEVER commit .env to the repo

# PostgreSQL connection string (Neon, Supabase, local Postgres). When set:
# - NextAuth OAuth users are stored in the DB
# - Watchlist, saved searches, role, digest, and briefs/alert prefs persist across deploys/devices
# Run: npx prisma migrate deploy
DATABASE_URL=

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_SECRET=your-reindex-secret-here
GEMINI_API_KEY=

# NextAuth (Google sign-in) — same Google Cloud project can be used for Gmail connect
AUTH_SECRET=
# Same origin as NEXT_PUBLIC_APP_URL — fixes some Vercel redirect issues
AUTH_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true or 1 to disable the passwordless "demo" login (Credentials provider)
# DEMO_AUTH_DISABLED=true
# Required for Gmail OAuth connect callback (must match Google Cloud "Authorized redirect URIs")
# Example: https://your-stable-domain.vercel.app/api/integrations/gmail/callback
GOOGLE_REDIRECT_URI=

# Public site URL — use the stable Production domain from Vercel → Settings → Domains.
# Do NOT use a one-off deployment URL (…-team-xxxx.vercel.app); those change every deploy.
# Example team production host: https://startup-compass-one.vercel.app
NEXT_PUBLIC_APP_URL=https://startup-compass-one.vercel.app

# LLM for brief copy (falls back gracefully if unset). Groq-compatible key:
LLM_API_KEY=
# Optional override; default llama-3.3-70b-versatile
LLM_MODEL=

# Legacy alias still supported by lib/agents/llm.ts
GROQ_API_KEY=

# Real Gmail inbox delivery (default off — briefs still saved in-app)
EMAIL_SEND_ENABLED=false
GMAIL_SEND_ENABLED=false

# Real SMS via Twilio (default off — alerts recorded as simulated)
SMS_SEND_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
