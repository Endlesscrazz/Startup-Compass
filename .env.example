# Copy this to .env and fill in your keys
# NEVER commit .env to the repo

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_SECRET=your-reindex-secret-here
GEMINI_API_KEY=

# NextAuth (Google sign-in) — same Google Cloud project can be used for Gmail connect
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true or 1 to disable the passwordless "demo" login (Credentials provider)
# DEMO_AUTH_DISABLED=true
# Required for Gmail OAuth connect callback (must match Google Cloud "Authorized redirect URIs")
# Example: https://your-app.vercel.app/api/integrations/gmail/callback
GOOGLE_REDIRECT_URI=

# Public site URL (used in email/SMS deep links)
NEXT_PUBLIC_APP_URL=https://startup-compass-one.vercel.app

# LLM for brief copy (falls back gracefully if unset). Groq-compatible key:
LLM_API_KEY=
# Optional override; default llama-3.3-70b-versatile
LLM_MODEL=

# Legacy alias still supported by lib/agents/llm.ts
GROQ_API_KEY=

# Real Gmail inbox delivery (default off — briefs still saved in-app)
EMAIL_SEND_ENABLED=false
GMAIL_SEND_ENABLED=false

# Real SMS via Twilio (default off — alerts recorded as simulated)
SMS_SEND_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=